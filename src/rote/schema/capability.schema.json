                {
                  "$ref": "#/$defs/ElementAbsent"
                },
                {
                  "$ref": "#/$defs/LocationMatches"
                },
                {
                  "$ref": "#/$defs/ValueEquals"
                },
                {
                  "$ref": "#/$defs/OutputPresent"
                },
                {
                  "$ref": "#/$defs/AllOf"
                },
                {
                  "$ref": "#/$defs/AnyOf"
                },
                {
                  "$ref": "#/$defs/Not"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Postcondition checked after the action; must discriminate before/after.",
          "title": "Expect"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
