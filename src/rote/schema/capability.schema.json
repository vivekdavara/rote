        "frame": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Frame name; omitted for the top-level document.",
          "title": "Frame"
        },
        "locators": {
          "items": {
            "discriminator": {
              "mapping": {
                "css": "#/$defs/CssLocator",
                "label": "#/$defs/LabelLocator",
                "role": "#/$defs/RoleLocator",
                "table_cell": "#/$defs/TableCellLocator"
