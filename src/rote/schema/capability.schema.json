    "TableCellLocator": {
      "additionalProperties": false,
      "description": "A cell, or an element inside a row, found by header text and row values.\n\n``headers`` pick the table (the innermost table whose header row contains all of\nthem). ``row`` picks exactly one row by cell values, and those values may be\ntemplates such as ``{{inputs.member_id}}``. The locator then points at either\nthe cell in ``column`` or the element described by ``then`` within that row.",
      "properties": {
        "by": {
          "const": "table_cell",
          "default": "table_cell",
          "title": "By",
          "type": "string"
        },
        "column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column"
        },
        "headers": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Headers",
          "type": "array"
        },
        "row": {
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1,
          "title": "Row",
          "type": "object"
        },
        "then": {
          "anyOf": [
            {
              "$ref": "#/$defs/InnerElement"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "headers",
        "row"
      ],
      "title": "TableCellLocator",
      "type": "object"
    },
    "Target": {
      "additionalProperties": false,
      "description": "A control within one frame, with ranked locator strategies.",
