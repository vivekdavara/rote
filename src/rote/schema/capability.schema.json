            },
            "oneOf": [
              {
                "$ref": "#/$defs/RoleLocator"
              },
              {
                "$ref": "#/$defs/LabelLocator"
              },
              {
                "$ref": "#/$defs/TableCellLocator"
              },
              {
                "$ref": "#/$defs/CssLocator"
              }
            ]
          },
          "minItems": 1,
          "title": "Locators",
          "type": "array"
        }
      },
      "required": [
        "locators"
      ],
      "title": "Target",
      "type": "object"
    },
    "TextVisible": {
      "additionalProperties": false,
      "description": "Text is rendered and visible (``display:none`` / ``visibility:hidden`` text does not count).\n\n``frame`` omitted means any frame. Templates such as ``{{inputs.member_id}}`` are allowed.",
      "properties": {
