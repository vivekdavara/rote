    "RoleLocator": {
      "additionalProperties": false,
      "description": "Accessible role and name, as the browser's accessibility engine computes them.\n\nAccessibility trees exist on desktop too (UIA, macOS AX), so this is the\nstrategy that carries over to non-web surfaces.",
      "properties": {
        "by": {
          "const": "role",
          "default": "role",
          "title": "By",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "role": {
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role"
      ],
      "title": "RoleLocator",
      "type": "object"
    },
    "SelectStep": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "select",
          "default": "select",
